{
  "version": 1,
  "dataset_root": ".runtime/datasets/vitext2sql",
  "database_dir": ".runtime/datasets/vitext2sql/database",
  "runs_dir": "reports/experiments",
  "models": [
    {
      "id": "visql_custom",
      "label": "Model GGUF của nhóm · Q4_K_M",
      "provider": "ollama",
      "model": "visql-custom:latest",
      "base_url": "http://127.0.0.1:11434",
      "num_gpu": 0,
      "num_ctx": 16384,
      "num_predict": 2048,
      "temperature": 0,
      "seed": 42,
      "timeout_s": 240
    },
    {
      "id": "qwen_base",
      "label": "Qwen2.5-Coder · gốc",
      "provider": "ollama",
      "model": "qwen2.5-coder:3b",
      "base_url": "http://127.0.0.1:11434",
      "num_gpu": 0,
      "num_ctx": 16384,
      "num_predict": 2048,
      "temperature": 0,
      "seed": 42,
      "timeout_s": 240
    },
    {
      "id": "qwen_ft",
      "label": "Qwen2.5-Coder · fine-tuned",
      "provider": "ollama",
      "model": "qwen2.5-coder-vitext2sql:3b",
      "base_url": "http://127.0.0.1:11434",
      "trained": true,
      "training_manifest": ".runtime/training/qwen-kaggle-merged/qwen-kaggle/training_manifest.json",
      "num_gpu": 0,
      "num_ctx": 16384,
      "num_predict": 2048,
      "temperature": 0,
      "seed": 42,
      "timeout_s": 240
    },
    {
      "id": "bedrock_haiku",
      "label": "Claude Haiku 4.5 · Amazon Bedrock",
      "provider": "bedrock",
      "model": "us.anthropic.claude-haiku-4-5-20251001-v1:0",
      "region": "us-east-1",
      "max_output_tokens": 2048,
      "temperature": 0,
      "timeout_s": 180
    }
  ],
  "presets": [
    {
      "id": "c0",
      "label": "C0 · Baseline",
      "c1": false,
      "c2": false,
      "c3": false,
      "c4": false
    },
    {
      "id": "c2",
      "label": "C0 + C2",
      "c1": false,
      "c2": true,
      "c3": false,
      "c4": false
    },
    {
      "id": "c2_c4",
      "label": "C0 + C2 + C4",
      "c1": false,
      "c2": true,
      "c3": false,
      "c4": true
    },
    {
      "id": "full",
      "label": "C1–C4 · Đầy đủ",
      "c1": true,
      "c2": true,
      "c3": true,
      "c4": true
    },
    {
      "id": "minus_c1",
      "label": "Đầy đủ − C1",
      "c1": false,
      "c2": true,
      "c3": true,
      "c4": true
    },
    {
      "id": "minus_c2",
      "label": "Đầy đủ − C2",
      "c1": true,
      "c2": false,
      "c3": true,
      "c4": true
    },
    {
      "id": "minus_c3",
      "label": "Đầy đủ − C3",
      "c1": true,
      "c2": true,
      "c3": false,
      "c4": true
    },
    {
      "id": "minus_c4",
      "label": "Đầy đủ − C4",
      "c1": true,
      "c2": true,
      "c3": true,
      "c4": false
    }
  ]
}
