# Copy to .env locally. Never commit or share .env.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Required when using temporary AWS credentials; leave blank for long-term keys.
AWS_SESSION_TOKEN=
AWS_DEFAULT_REGION=us-east-1
# Optional: use an AWS Bedrock API bearer token instead of the keys above.
# AWS_BEARER_TOKEN_BEDROCK=
# Optional legacy OpenAI provider (only when added to experiment.json).
# OPENAI_API_KEY=
